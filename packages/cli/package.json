{
  "name": "staticforge",
  "version": "0.1.1",
  "description": "CLI-first static site generator with accessibility checking and multi-cloud deploys",
  "keywords": [
    "staticforge",
    "static-site-generator",
    "ssg",
    "accessibility",
    "wcag",
    "cli",
    "mcp",
    "aws",
    "cloudfront",
    "azure",
    "static-web-apps"
  ],
  "homepage": "https://github.com/elchanio-76/sforge#readme",
  "bugs": {
    "url": "https://github.com/elchanio-76/sforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchanio-76/sforge.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Eleftherios Chaniotakis",
  "type": "module",
  "bin": {
    "sforge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@staticforge/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@staticforge/aws": "workspace:*",
    "@staticforge/azure": "workspace:*",
    "@staticforge/build": "workspace:*",
    "@staticforge/checker": "workspace:*",
    "@staticforge/cloudflare": "workspace:*",
    "@staticforge/core": "workspace:*",
    "@staticforge/dev-server": "workspace:*",
    "@staticforge/iac": "workspace:*",
    "@staticforge/provider-api": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
