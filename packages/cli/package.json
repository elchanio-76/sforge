{
  "name": "staticforge",
  "version": "0.0.0",
  "description": "CLI-first static site generator with accessibility checking and multi-cloud deploys",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sforge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@staticforge/build": "workspace:*",
    "@staticforge/core": "workspace:*",
    "commander": "^15.0.0"
  }
}
