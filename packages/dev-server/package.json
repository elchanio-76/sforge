{
  "name": "@staticforge/dev-server",
  "version": "0.4.0",
  "description": "Local preview and live-reloading development server for staticforge",
  "keywords": [
    "staticforge"
  ],
  "homepage": "https://github.com/elchanio-76/sforge#readme",
  "bugs": {
    "url": "https://github.com/elchanio-76/sforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchanio-76/sforge.git",
    "directory": "packages/dev-server"
  },
  "license": "MIT",
  "author": "Eleftherios Chaniotakis",
  "type": "module",
  "exports": {
    ".": {
      "@staticforge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "client"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@staticforge/build": "workspace:*",
    "@staticforge/checker": "workspace:*",
    "@staticforge/core": "workspace:*",
    "@staticforge/server": "workspace:*",
    "chokidar": "^6.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
