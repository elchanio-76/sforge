{
  "name": "@staticforge/build",
  "version": "0.3.0",
  "description": "Site build pipeline: discovery, URL mapping, rendering and output",
  "keywords": [
    "staticforge"
  ],
  "homepage": "https://github.com/elchanio-76/sforge#readme",
  "bugs": {
    "url": "https://github.com/elchanio-76/sforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchanio-76/sforge.git",
    "directory": "packages/build"
  },
  "license": "MIT",
