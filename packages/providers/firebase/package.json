{
  "name": "@staticforge/firebase",
  "version": "0.3.1",
  "description": "Firebase provider for staticforge: Firebase Hosting, preview channels, rollback by release",
  "keywords": [
    "staticforge",
    "firebase",
    "firebase-hosting",
    "opentofu",
    "terraform"
  ],
  "homepage": "https://github.com/elchanio-76/sforge#readme",
  "bugs": {
    "url": "https://github.com/elchanio-76/sforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchanio-76/sforge.git",
    "directory": "packages/providers/firebase"
  },
  "license": "MIT",
  "author": "Eleftherios Chaniotakis",
  "type": "module",
  "exports": {
    ".": {
      "@staticforge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "terraform/**/*.tf",
    "terraform/**/*.hcl",
    "!terraform/**/.terraform.lock.hcl",
    "!terraform/**/tests/**"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@staticforge/cloudflare": "workspace:*"
  },
  "dependencies": {
    "@staticforge/core": "workspace:*",
    "@staticforge/iac": "workspace:*",
    "@staticforge/provider-api": "workspace:*",
    "google-auth-library": "^11.0.0"
  },
  "devDependencies": {
    "@staticforge/cloudflare": "workspace:*"
  }
}
