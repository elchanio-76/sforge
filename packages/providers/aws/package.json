{
  "name": "@staticforge/aws",
  "version": "0.4.0",
  "description": "AWS provider for staticforge: private S3 + CloudFront (OAC), KeyValueStore versions, previews",
  "keywords": [
    "staticforge",
    "aws",
    "s3",
    "cloudfront",
    "opentofu",
    "terraform"
  ],
  "homepage": "https://github.com/elchanio-76/sforge#readme",
  "bugs": {
    "url": "https://github.com/elchanio-76/sforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchanio-76/sforge.git",
    "directory": "packages/providers/aws"
  },
  "license": "MIT",
  "author": "Eleftherios Chaniotakis",
  "type": "module",
  "exports": {
    ".": {
      "@staticforge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "terraform/**/*.tf",
    "terraform/**/*.js",
    "terraform/**/*.mjs",
    "terraform/**/*.hcl",
    "!terraform/**/.terraform.lock.hcl",
    "!terraform/**/tests/**"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1158.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1158.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@aws-sdk/client-iam": "^3.1158.0",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-ssm": "^3.1158.0",
    "@aws-sdk/client-sts": "^3.1158.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@staticforge/core": "workspace:*",
    "@staticforge/iac": "workspace:*",
    "@staticforge/provider-api": "workspace:*",
    "@staticforge/server": "workspace:*"
  },
  "devDependencies": {
    "@smithy/util-stream": "^4.8.2",
    "@staticforge/cloudflare": "workspace:*",
    "aws-sdk-client-mock": "^4.1.0"
  }
}
