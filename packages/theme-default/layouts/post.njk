{% extends "layouts/base.njk" %}
{% block main %}
<article class="page post" data-testid="post" data-pagefind-body>
  <header class="page-header">
    <h1>{{ page.title }}</h1>
    {% if page.date %}
    <p class="post-meta">
      Published <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(page.lang) }}</time>
      {% if page.updated %}
      · Updated <time datetime="{{ page.updated | isoDate }}">{{ page.updated | readableDate(page.lang) }}</time>
      {% endif %}
    </p>
    {% endif %}
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
  {% if page.tagLinks.length %}
  <footer class="post-footer">
    <h2 class="visually-hidden">Tags</h2>
    {% set tagLinks = page.tagLinks %}
    {% include "partials/tag-links.njk" %}
  </footer>
  {% endif %}
</article>
{% endblock %}
