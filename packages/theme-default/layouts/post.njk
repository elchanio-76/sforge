{% extends "layouts/base.njk" %}
{% block main %}
<article class="page post" data-testid="post">
  <header class="page-header">
    <h1>{{ page.title }}</h1>
    {% if page.date %}
    <p class="post-meta">
      Published <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(page.lang) }}</time>
      {% if page.updated %}
      · Updated <time datetime="{{ page.updated | isoDate }}">{{ page.updated | readableDate(page.lang) }}</time>
      {% endif %}
    </p>
    {% endif %}
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
  {% if page.tags.length %}
  <footer class="post-footer">
    <h2 class="visually-hidden">Tags</h2>
    <ul class="tags" data-testid="tags">
      {% for tag in page.tags %}
      <li>{{ tag }}</li>
      {% endfor %}
    </ul>
  </footer>
  {% endif %}
</article>
{% endblock %}
