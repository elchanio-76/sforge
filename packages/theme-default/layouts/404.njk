{% extends "layouts/base.njk" %}
{% block main %}
<article class="page not-found" data-testid="not-found">
  <header class="page-header">
    <h1>{{ page.title }}</h1>
  </header>
  <div class="content">
    {% if content %}
    {{ content | safe }}
    {% else %}
    <p>Sorry, there is no page at this address. It may have moved, or the link may be wrong.</p>
    <p><a href="/">Go to the home page</a></p>
    {% endif %}
  </div>
</article>
{% endblock %}
