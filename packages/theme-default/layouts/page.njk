{% extends "layouts/base.njk" %}
{% block main %}
<article class="page" data-testid="page" data-pagefind-body>
  <header class="page-header">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
    <p class="lede">{{ page.description }}</p>
    {% endif %}
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
</article>
{% endblock %}
