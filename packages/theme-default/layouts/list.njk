{% extends "layouts/base.njk" %}
{% block main %}
<article class="page list" data-testid="list">
  <header class="page-header">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
    <p class="lede">{{ page.description }}</p>
    {% endif %}
  </header>
  {% if content %}
  <div class="content" data-pagefind-body>
    {{ content | safe }}
  </div>
  {% endif %}
  {% if pagination %}
  {% set items = pagination.items %}
  {% include "partials/page-list.njk" %}
  {% include "partials/pagination.njk" %}
  {% endif %}
</article>
{% endblock %}
