{% extends "layouts/base.njk" %}
{% block main %}
<article class="page list" data-testid="tag">
  <header class="page-header">
    <h1>{{ page.title }}</h1>
    <p class="lede">{{ tag.count }} page{% if tag.count != 1 %}s{% endif %} with this tag.</p>
  </header>
  {% set items = tag.items %}
  {% include "partials/page-list.njk" %}
  {% if tagsUrl %}
  <p><a href="{{ tagsUrl }}">All tags</a></p>
  {% endif %}
</article>
{% endblock %}
