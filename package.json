{
  "name": "staticforge-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:iac": "SFORGE_IAC_TESTS=1 vitest run packages/providers/aws/test/workspace.integration.test.ts packages/providers/azure/test/workspace.integration.test.ts packages/providers/cloudflare/test/workspace.integration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sforge": "node packages/cli/dist/bin.js",
    "schema:generate": "pnpm build && for name in config output diagnostics; do node packages/cli/dist/bin.js schema $name > packages/cli/schema/$name.schema.json; done && mv packages/cli/schema/config.schema.json packages/cli/schema/staticforge.schema.json",
    "bench": "node scripts/bench.mjs",
    "test:pack": "node scripts/pack-test.mjs",
    "test:live": "vitest run packages/cli/test/live.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
